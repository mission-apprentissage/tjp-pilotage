{
  "variable": {
    "PRODUCT_NAME": {},
    "REPO_NAME": {},
    "VERSION": {},
    "CHANNEL": {},
    "DEPS_ID": {},
    "HTTP_PROXY": {
      "default": ""
    },
    "HTTPS_PROXY": {
      "default": ""
    },
    "NO_PROXY": {
      "default": "localhost,127.0.0.1,docker"
    }
  },
  "group": {
    "qualification": {
      "targets": ["server", "ui-qualification"]
    },
    "diffusion": {
      "targets": ["server", "ui-diffusion"]
    },
    "preproduction": {
      "targets": ["server", "ui-preproduction"]
    },
    "production": {
      "targets": ["server", "ui-production"]
    },
    "local": {
      "targets": ["server", "ui-local"]
    }
  },
  "target": {
    "common": {
      "args": {
        "PUBLIC_VERSION": "${VERSION}",
        "PUBLIC_PRODUCT_NAME": "${PRODUCT_NAME}",
        "PUBLIC_REPO_NAME": "${REPO_NAME}",
        "HTTP_PROXY": "${HTTP_PROXY}",
        "HTTPS_PROXY": "${HTTPS_PROXY}",
        "REGISTRY": "docker-group-global-nexus3.forge.education.gouv.fr",
        "NO_PROXY": "${NO_PROXY}"
      },
      "dockerfile": "Dockerfile",
      "platforms": ["linux/amd64"],
      "labels": {
        "org.opencontainers.image.source": "https://gitlab.forge.education.gouv.fr/orion/${REPO_NAME}",
        "org.opencontainers.image.licenses": "MIT"
      }
    },
    "server": {
      "inherits": ["common"],
      "tags": [
        "harbor.forge.education.gouv.fr/orion-orion/ij_${PRODUCT_NAME}_server:${VERSION}",
        "harbor.forge.education.gouv.fr/orion-orion/ij_${PRODUCT_NAME}_server:${CHANNEL}"
      ],
      "labels": {
        "org.opencontainers.image.description": "Server"
      },
      "target": "server"
    },
    "ui": {
      "inherits": ["common"],
      "matrix": {
        "ENV": ["qualification", "diffusion", "preproduction", "production", "local"]
      },
      "name": "ui-${ENV}",
      "args": {
        "PUBLIC_ENV": "${ENV}"
      },
      "tags": [
        "harbor.forge.education.gouv.fr/orion-orion/ij_${PRODUCT_NAME}_ui:${VERSION}-${ENV}",
        "harbor.forge.education.gouv.fr/orion-orion/ij_${PRODUCT_NAME}_ui:${CHANNEL}-${ENV}"
      ],
      "labels": {
        "org.opencontainers.image.description": "Ui"
      },
      "target": "ui"
    }
  }
}
